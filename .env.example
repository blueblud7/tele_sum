# Telegram API credentials (사용자 계정용 - 메시지 수집/포워딩)
# https://my.telegram.org 에서 발급
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+821012345678

# Telegram Bot (요약 게시용)
# BotFather에서 발급, 출력 채널의 관리자로 추가 + Post Messages 권한 필요
TELEGRAM_BOT_TOKEN=your_bot_token
TARGET_CHANNEL=@your_output_channel

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-nano

# 수집/요약 설정
LOOKBACK_MINUTES=15        # 첫 실행 시 룩백 윈도우 (이후 last_seen.json 기반)
MIN_MESSAGES=1             # 채널당 최소 신규 메시지 수
LANGUAGE=korean            # 요약 언어
MAX_FORWARDS_PER_CHANNEL=3 # 채널당 큐레이션할 메시지 수 (t.me 링크 기준)

# 채널 필터 (선택사항 - 비워두면 전체 채널)
# CHANNEL_FILTER=channel1,channel2,channel3

# 클라우드 DB (Neon Postgres - pooled connection 권장)
DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require
