# Telegram API credentials
# https://my.telegram.org 에서 발급
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+821012345678

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# 요약 설정
HOURS_BACK=24          # 몇 시간치 메시지를 요약할지
MIN_MESSAGES=3         # 최소 메시지 수 (이하면 채널 스킵)
LANGUAGE=korean        # 요약 언어

# 채널 필터 (선택사항 - 비워두면 전체 채널)
# 쉼표로 구분한 채널 username 목록
# CHANNEL_FILTER=channel1,channel2,channel3
